# Siidaa Barruu - Monorepo Environment Variables Reference
# ==========================================================

# Database & Authentication (server/.env)
DATABASE_URL="postgresql://username:password@localhost:5432/siidaa_barruu?sslmode=require"
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
PORT=5000
NODE_ENV=development
CLIENT_URL="http://localhost:3000"
LOG_LEVEL="info"
SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"


# Password Reset Delivery / Webhooks (server/.env)
PASSWORD_RESET_WEBHOOK_URL="https://example.com/api/webhooks/password-reset"
PASSWORD_RESET_WEBHOOK_SECRET="your-webhook-hmac-or-bearer-token-secret"

# Cloudinary Media Storage (server/.env)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Frontend Configuration (client/.env.local)
NEXT_PUBLIC_API_URL="http://localhost:5000/api"
