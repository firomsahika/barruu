{
  "name": "siidaa-barruu-server",
  "version": "1.0.0",
  "description": "Siidaa Barruu - Afaan Oromo Literary Platform Backend",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "NODE_ENV=test tsx --test \"src/**/*.test.ts\"",
    "test:coverage": "NODE_ENV=test c8 --all --include=\"src/lib/**\" --include=\"src/validations/**\" --include=\"src/middleware/**\" --exclude=\"src/**/*.test.ts\" --exclude=\"src/tests/**\" --exclude=\"src/__tests__/**\" --check-coverage --lines 50 tsx --test \"src/**/*.test.ts\"",
    "lint": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "ts-node src/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "pino": "^10.4.0",
    "slug": "^12.0.1",
    "socket.io": "^4.8.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.2.0",
    "@types/slug": "^5.0.9",
    "@types/socket.io": "^3.0.2",
    "@types/supertest": "^7.2.1",
    "c8": "^12.0.0",
    "nodemon": "^3.1.14",
    "prisma": "^6.19.2",
    "supertest": "^7.3.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
